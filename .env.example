# Copy to .env.local. Never commit credentials.
AI_GATEWAY_API_KEY=
EVE_HOST=http://127.0.0.1:2000
PORT=3100

# Optional Google Web OAuth client; you can also save these in Connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set 0 to run the dashboard without auto-starting the local AI service.
AUTO_START_AGENT=1

# Production host only: keep these in private hosting environment settings.
# NODE_ENV=production
# APP_ORIGIN=https://your-real-hostname.example
# APP_OWNER_USER=owner
# APP_OWNER_PASSWORD=choose-at-least-20-characters
# AI_RUNTIME_PASSWORD=generate-a-random-value-of-at-least-32-characters
# DATA_DIR=/var/data/agent-worker
